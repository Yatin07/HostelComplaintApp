<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="left"
    android:background="@drawable/images">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="left">

        <!-- ARROW -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:id="@+id/btnBackPopup"
            android:src="@drawable/baseline_arrow_back_24"
            android:tint="@color/purple"/>

        <!-- BUTTON -->
    </LinearLayout>


    <TextView
        android:text="Rules"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="120dp"/>

    <TextView
        android:text="1. Submit complaints only for genuine issues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="2. Do not submit duplicate complaints."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="3. Provide correct room number and details."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="4. Avoid inappropriate language."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="5. Do not misuse the app."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="6. Allow time for resolution."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="7. Track complaint status."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="8. Contact warden if unresolved."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="9. Follow hostel rules."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        android:layout_gravity="center"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/img2"></ImageView>

</LinearLayout>