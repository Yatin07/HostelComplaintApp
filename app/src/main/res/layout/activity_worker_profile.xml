<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <include layout="@layout/top_bar"
        android:id="@+id/inc_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include layout="@layout/bottom_nav"
        android:id="@+id/inc_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_below="@id/inc_top_bar"
        android:layout_above="@id/inc_bottom_nav">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 🌟 HERO BADGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_hero_bg"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:elevation="4dp"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/baseline_account_circle_24"
                        android:background="@drawable/profile_avatar_ring"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:padding="12dp"
                        app:tint="#1E3A8A"
                        android:elevation="4dp"/>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker Information"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="8dp"/>

            <!-- 🔳 DETAILS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/menu_card_bg"
                android:elevation="2dp"
                android:padding="16dp">

                <!-- Worker ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker ID"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8" />

                <TextView
                    android:id="@+id/tvWorkerId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="W-12345"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etWorkerId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="W-12345"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:background="@drawable/edittext_bg"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"
                    android:enabled="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="12dp"/>

                <!-- Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8" />

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:background="@drawable/edittext_bg"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"
                    android:enabled="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="12dp"/>

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8" />

                <TextView
                    android:id="@+id/tvWorkerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="worker@hostel.com"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etWorkerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="worker@hostel.com"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:background="@drawable/edittext_bg"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"
                    android:enabled="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="12dp"/>

                <!-- Role -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8" />

                <TextView
                    android:id="@+id/tvWorkerRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Electrician"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="4dp" />

                <EditText
                    android:id="@+id/etWorkerRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Electrician"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:background="@drawable/edittext_bg"
                    android:padding="8dp"
                    android:enabled="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:backgroundTint="#3B6FD4"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:padding="14dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:backgroundTint="#EF4444"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:padding="14dp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

    </LinearLayout>
</RelativeLayout>
