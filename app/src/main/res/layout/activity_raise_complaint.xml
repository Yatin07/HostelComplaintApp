<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#3B6FD4"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raise a Complaint"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"

            android:layout_marginStart="78dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Describe your issue in detail so we can resolve it quickly."
                android:textColor="#64748B"
                android:textSize="15sp"
                android:layout_marginBottom="24dp"/>

            <!-- Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/menu_card_bg"
                android:elevation="2dp"
                android:padding="20dp">

                <!-- Title Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complaint Title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/input_bg"
                    android:hint="E.g., Fan not working"
                    android:textColorHint="#94A3B8"
                    android:paddingHorizontal="16dp"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:singleLine="true"/>

                <!-- Category Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/input_bg"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:popupBackground="@drawable/menu_card_bg"/>
                </LinearLayout>

                <!-- Room & Bed Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Room No."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155"
                            android:layout_marginBottom="8dp"/>
                            
                        <EditText
                            android:id="@+id/etRoom"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/input_bg"
                            android:hint="E.g., 204"
                            android:textColorHint="#94A3B8"
                            android:paddingHorizontal="16dp"
                            android:textColor="#1E293B"
                            android:inputType="number"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bed No."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/bednumber"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/input_bg"
                            android:hint="E.g., B"
                            android:textColorHint="#94A3B8"
                            android:paddingHorizontal="16dp"
                            android:textColor="#1E293B"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:background="@drawable/input_bg"
                    android:hint="Provide any additional details..."
                    android:textColorHint="#94A3B8"
                    android:padding="16dp"
                    android:textColor="#1E293B"
                    android:textSize="16sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:baselineAligned="false">

                <!-- Location Button -->
                <Button
                    android:id="@+id/btnLocation"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="Attach Location"
                    android:backgroundTint="#EFF6FF"
                    android:textColor="#1D4ED8"
                    app:icon="@drawable/ic_location_on"
                    app:iconTint="#1D4ED8"
                    app:iconGravity="textStart"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    android:elevation="0dp"
                    android:layout_marginEnd="8dp"/>

                <!-- Upload Image Button -->
                <Button
                    android:id="@+id/btnUploadImage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="Upload Image"
                    android:backgroundTint="#EFF6FF"
                    android:textColor="#1D4ED8"
                    app:icon="@drawable/ic_image_add"
                    app:iconTint="#1D4ED8"
                    app:iconGravity="textStart"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    android:elevation="0dp"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- Image Preview Box (Hidden initially until chosen) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_bg"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:background="@android:color/transparent"/>
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Submit Complaint"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"
                android:layout_marginBottom="40dp"
                android:elevation="4dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- 🔻 BOTTOM NAVBAR -->
    <View
        android:id="@+id/bottomNavBorder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"/>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/gotohomepg"
                app:tint="#2F6FED"
                android:src="@drawable/baseline_home_24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#2F6FED"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_notifications_24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/howtouseapp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_person_add_alt_24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guide"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:id="@+id/imgprof"
                android:layout_height="24dp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_account_circle_24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>