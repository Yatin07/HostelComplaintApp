<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- ── TOP BAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/toolbar_bg">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_arrow_back_24"
            android:tint="@color/white"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emergency Contacts"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- Edit / Done toggle -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/white"/>

    </LinearLayout>

    <!-- ── SCROLLABLE CONTENT ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ─── WARDEN NUMBERS SECTION ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔  Warden Numbers"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp"/>

            <!-- WARDEN 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warden 1 — Name"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden1Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Warden 1"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="textPersonName"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden1Phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+91 524548784545"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WARDEN 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warden 2 — Name"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden2Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Warden 2"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="textPersonName"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden2Phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+91 524548784545"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WARDEN 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warden 3 — Name"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden3Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Warden 3"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="textPersonName"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etWarden3Phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+91 524548784545"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── DOCTOR RECEPTION SECTION ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥  Doctor Reception"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reception Phone Number"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etDoctorPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+91 256585215"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:enabled="false"
                        android:background="@null"
                        android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── SAVE BUTTON (hidden until edit mode) ─── -->
            <Button
                android:id="@+id/btnSaveContacts"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Changes"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1A237E"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>