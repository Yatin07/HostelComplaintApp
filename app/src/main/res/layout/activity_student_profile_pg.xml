<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔝 TOP NAVBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/toolbar_bg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:contentInsetEnd="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_arrow_back_24"
                app:tint="@color/white"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv1WardenName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/white"
                    android:textSize="25dp"
                    android:textStyle="bold"/>


            </LinearLayout>

            <!-- RIGHT SIDE PROFILE ICON -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:id="@+id/imgnmlogo"
                android:src="@drawable/nmm"/>
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>


    <!-- ✅ MODERNIZED MIDDLE UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#F6F8FB">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- 🌟 HERO PROFILE CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/profile_hero_bg"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:elevation="8dp"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:background="@drawable/profile_avatar_ring"
                        android:elevation="4dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="52dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/transparent">

                            <ImageView
                                android:id="@+id/profileImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/baseline_person_add_alt_24"
                                android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvName1"
                        android:text="Student Name Here"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvRoomno"
                        android:text="Room NO : 223"
                        android:textColor="#E2E8F0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:text="pchinmay098@gmail.com"
                        android:textColor="#FBBF24"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/status_bg"
                        android:backgroundTint="#33000000"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="8dp"/>

                <!-- 🔳 MENU ITEMS CONTAINER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/menu_card_bg"
                    android:elevation="2dp"
                    android:paddingVertical="8dp">

                    <!-- Menu 1: Edit Profile -->
                    <LinearLayout
                        android:id="@+id/EditProfileinformation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_edit_profile"
                            app:tint="#2F6FED"
                            android:background="@drawable/menu_icon_bg"
                            android:padding="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Edit Profile Information"
                            android:textSize="16sp"
                            android:textColor="#1E293B"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="16dp"/>

                    <!-- Menu 2: Security -->
                    <LinearLayout
                        android:id="@+id/security"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_security_shield"
                            app:tint="#2F6FED"
                            android:background="@drawable/menu_icon_bg"
                            android:padding="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Security"
                            android:textSize="16sp"
                            android:textColor="#1E293B"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="16dp"/>

                    <!-- Menu 3: Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_theme_mode"
                            app:tint="#2F6FED"
                            android:background="@drawable/menu_icon_bg"
                            android:padding="8dp"/>

                        <TextView
                            android:id="@+id/theme"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Dark Mode"
                            android:textSize="16sp"
                            android:textColor="#1E293B"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"/>

                        <Switch
                            android:id="@+id/switchTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="#2F6FED"
                            android:trackTint="#CBD5E1"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="16dp"/>

                    <!-- Menu 4: Help -->
                    <LinearLayout
                        android:id="@+id/contactus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_help_support"
                            app:tint="#2F6FED"
                            android:background="@drawable/menu_icon_bg"
                            android:padding="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Help &amp; Support"
                            android:textSize="16sp"
                            android:textColor="#1E293B"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Logout Button -->
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:backgroundTint="#EF4444"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="14dp"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <!-- 🔻 BOTTOM NAVBAR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:weightSum="4">

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/gotohomepg"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_home_24"/>

            <TextView android:text="Home"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_notifications_24"/>

            <TextView android:text="Notification"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/howtouseapp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#94A3B8"
                android:src="@drawable/baseline_person_add_alt_24"/>

            <TextView android:text="Guide"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgprof"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#2F6FED"
                android:src="@drawable/baseline_account_circle_24"/>

            <TextView android:text="Profile"
                android:textColor="#2F6FED"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>


</LinearLayout>

